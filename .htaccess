# ==========================================================================
#  Outsourcify — Apache / LiteSpeed (Hostinger, cPanel)
#  ყველა საჯარო მისამართი index.php-ზე გადის; ფაილები პირდაპირ ემსახურება.
# ==========================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.php
Options -Indexes -MultiViews

RewriteEngine On

# --- 1. HTTPS + www → არა-www (ერთი კანონიკური ჰოსტი) ------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- 2. /index.php → / ------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]

# --- 3. დახურული დირექტორიები --------------------------------------------
RewriteRule ^(content|inc|tools)(/|$) - [F,L]

# --- 4. front controller ----------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# --- 5. შეკუმშვა -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- 6. ქეშირება (CSS/JS-ს მისამართში ?v=ჰეში აქვს — ცვლილებისას თავისით ახლდება)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# --- 7. უსაფრთხოების ჰედერები -------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
